APP_ENV=development
DEBUG=true
APP_TITLE=fast-agent
PROJECT_NAME=fast-agent
APP_DESCRIPTION=轻量 AI 应用后端模板

DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/fast_agent_db

FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=AdminPass123
FIRST_SUPERUSER_EMAIL=admin@example.com

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=240
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

SWAGGER_UI_USERNAME=admin
SWAGGER_UI_PASSWORD=admin12345

REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Rate limit — Redis 存储（多 worker 共享计数），本地开发若无 Redis 自动 fallback 内存
RATE_LIMIT_DEFAULT=200/day,50/hour
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# # Agent / LLM — API Key 用于 DashScope 网关
# API_KEY=your-dashscope-api-key
# APPCODE=your-appcode
# # AGENT_MODEL=qwen3.7-max
# # AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# # AGENT_MAX_STEPS=6
# # COMPRESS_MODEL=deepseek-v4-flash
# # SUMMARY_TRIGGER_RUNS=10
# # KEEP_RECENT_RUNS=4
# # MAX_SUMMARY_CHARS=1500
# # AGENT_CACHE_TTL=7200

# 压缩模型（标题生成等轻量任务）
COMPRESS_MODEL=deepseek-v4-flash
SUMMARY_TRIGGER_RUNS=10
KEEP_RECENT_RUNS=4
MAX_SUMMARY_CHARS=1500
SUMMARY_LOCK_TTL_SECONDS=600

# 切换到千问只需改为：
# AGENT_NAME=fast-agent
# AGENT_PROVIDER=Alibaba
# AGENT_MODEL=qwen3.7-max
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEP_SEEK_API_KEY=sk-your-dashscope-key

# 通义千问apikey（必填）
API_KEY=your_dashscope_api_key

# mcp提供的appcode服务器密钥，固定是这个不变
APPCODE=your_appcode

# deepseek（必填）
DEEP_SEEK_API_KEY=your_deepseek_api_key

# MCP server URLs（默认值无需改）
# MCP_WEB_SEARCH_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# MCP_AMAP_MAPS_URL=https://dashscope.aliyuncs.com/api/v1/mcps/amap-maps/mcp
# MCP_WEATHER_URL=https://ai.weiniai.cn/weather
# MCP_SEARCH_IMAGE_URL=https://ai.weiniai.cn/search-image
# MCP_MAP_CRAWLER_URL=https://ai.weiniai.cn/search-geocoder

# ── 腾讯地图（选填）──────────────────────────────────────────────────
# QQ_MAP_KEY=
# TENCENT_APPID=
# TENCENT_SECRETID=
# TENCENT_SECRETKEY=
